# ── WebRTC / TURN ─────────────────────────────────────────────
# coturn runs as this stack's `coturn` service and is the ONE TURN server both
# products use — that pair (username/credential) is shared by coturn, Asterisk
# and every browser the portals hand it to, so it must be written to FreePBX's
# settings DB as well (docker-entrypoint-full.sh does that; the DB copy is what
# regenerates rtp_additional.conf on Apply Config).
TURN_SERVER=turn:coturn.zeus.innotel.us:3478

# Browser-facing softphone WSS URL. Routed through NPM (wss://ws.<domain>/ws)
# so the browser gets the wildcard certificate, not Asterisk's self-signed one.
# (Same override name as capstone.)
FREEPBX_WSS_URL=wss://ws.zeus.innotel.us/ws
TURN_USERNAME=turnuser-a0af3124ac87
TURN_CREDENTIAL=UIAf6T7hac1b9iKZ3QqiCWlFd7syLNQsDpNpr4wRU
# Host port coturn is published on (the container itself stays on 3478). Must
# match the router forward. Also builds Asterisk's stunaddr (coturn:<port>).
TURN_LISTENING_PORT=3478
# Auth realm coturn advertises. Any stable string works; keep it fixed, because
# browsers that cached a realm have to re-auth when it changes.
TURN_REALM=73.68.203.71
# UDP relay range. These ports MUST be published (see the coturn service in
# docker-compose*.yml) or only the TURN control channel is reachable and every
# relayed call is silent.
TURN_RELAY_PORT_START=49152
TURN_RELAY_PORT_END=49251
# Public address coturn advertises for relayed candidates. Leave empty and the
# container detects it per start via the image's detect-external-ip (correct on
# a dynamic WAN IP, which is the common case). Set it only where that probe is
# blocked by DNS policy — a pinned address silently rots when the WAN changes
# and calls then connect with no audio.
TURN_EXTERNAL_IP=

# ── RTP media (Asterisk) ──────────────────────────────────────
# The RTP plane Zeus owns: every consumer — Zeus softphones/portal and the
# Capstone agent add-on — rides this one range. The same values are published
# by the freepbx service in docker-compose.full.yml, capped into
# /etc/asterisk/rtp_custom.conf, and written into FreePBX's kvstore_Sipsettings
# by docker-entrypoint-full.sh (that DB copy is what regenerates
# rtp_additional.conf on Apply Config). All three must agree, or media silently
# escapes the published ports and calls go one-way.
# Keep Webmin (TCP 10000) and the TURN relay range out of this block. The two
# sides of the compose mapping must stay the same length (the container side is
# fixed at 10101-10120 — what Asterisk binds).
FREEPBX_RTP_PORT_START=10101
FREEPBX_RTP_PORT_END=10120
# STUN/TURN address Asterisk's RTP engine uses. Empty -> the local coturn
# compose service (coturn:<TURN_LISTENING_PORT>). Set it when that alias is not
# resolvable from the PBX container (e.g. a remote TURN host, or 127.0.0.1 on a
# bare-metal install). Never host.docker.internal — Asterisk's resolver fails
# on it and silently disables STUN.

