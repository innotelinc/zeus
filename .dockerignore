node_modules
.git
.gitignore
.next
.turbo
data
# Pinned build inputs (scripts/fetch-vendor.sh).
# Dockerfile.full COPYs the three FreePBX tarballs by name, so those stay;
# everything else under vendor/ is excluded — a vendored application tree
# copied in would be typechecked by the portal's `npm run build` (its own
# frontend deps, such as axios/vitest/react-router, are not deps here) and
# fail the image build.
vendor/*
!vendor/*.tgz
!vendor/*.tgz.gpg
*.log
.env
.env.local
.env.development
.env.test
.npm
.cache
coverage
.DS_Store
*.md
!README.md
