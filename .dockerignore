node_modules
.git
.gitignore
.next
.turbo
data
# Pinned build inputs (scripts/fetch-vendor.sh, scripts/fetch-ava.sh).
# Dockerfile.full COPYs the three FreePBX tarballs by name, so those stay;
# everything else under vendor/ is excluded — most importantly the AVA source
# tree, which is a whole application. Copying it in made the portal's
# `npm run build` typecheck AVA's own frontend (axios, vitest, react-router
# are not deps here) and fail the image build.
vendor/*
!vendor/*.tgz
!vendor/*.tgz.gpg
*.log
.env
.env.local
.env.development
.env.test
.npm
.cache
coverage
.DS_Store
*.md
!README.md
