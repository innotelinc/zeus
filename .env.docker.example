# ═══════════════════════════════════════════════════════════════
# Innotel PBX Portal — Docker Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy:    cp .env.docker.example .env
# Run:     docker compose up -d
#
# All paths must use remote server hostnames (not localhost).
# The PBX portal runs in a container and connects to external
# FreePBX, Asterisk, VoIP.ms, AvantFax, Atlas, and Stripe.
# ═══════════════════════════════════════════════════════════════

# ── Session ──────────────────────────────────────────────────
# Random 64-char hex secret (generate: openssl rand -hex 32)
SESSION_SECRET=

# ── VoIP.ms REST API ─────────────────────────────────────────
# Your VoIP.ms API credentials (email + password)
# Get these at: https://voip.ms/m/apidocs.php
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=

# Optional shared secret for incoming SMS webhook verification
VOIPMS_WEBHOOK_SECRET=
# ── FreePBX (OAuth2 API) ─────────────────────────────────────
# The URL of your FreePBX 17 server
FREEPBX_URL=https://voice.yourdomain.com
# OAuth2 client credentials (created by setup.sh or FreePBX Admin → API)
FREEPBX_CLIENT_ID=
FREEPBX_CLIENT_SECRET=

# ── Asterisk AMI (Manager Interface) ─────────────────────────
# Real-time call monitoring & CDR collection
ASTERISK_AMI_HOST=voice.yourdomain.com
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_SECRET=

# ── WebRTC Softphone (PJSIP WebSocket) ───────────────────────
# WebSocket URL for browser-based softphone
NEXT_PUBLIC_FREEPBX_WSS_URL=wss://voice.yourdomain.com:8089/ws

# ── TURN Server (NAT traversal for WebRTC) ───────────────────
# Optional but recommended for users behind NAT
NEXT_PUBLIC_TURN_SERVER=turn:voice.yourdomain.com:3478
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── AvantFax (Web client) ────────────────────────────────────
AVANTFAX_URL=http://voice.yourdomain.com:8080/avantfax
NEXT_PUBLIC_AVANTFAX_URL=http://voice.yourdomain.com:8080/avantfax

# ── Atlas Platform (cross-system signup) ─────────────────────
ATLAS_API_URL=https://atlas.yourdomain.com
ATLAS_API_KEY=

# ── Stripe (billing / payments) ──────────────────────────────
# Get these at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_CONSUMER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=production
