# ═══════════════════════════════════════════════════════════════
# Innotel PBX — Full-Stack Docker Environment Variables
# ═══════════════════════════════════════════════════════════════
# This file drives docker-compose.full.yml (Asterisk + FreePBX +
# PBX Portal running side-by-side in Docker).
#
# Setup:
#   1. Copy:  cp .env.docker.example .env
#   2. Fill in the values below (at minimum, the VoIP.ms creds)
#   3. Start: docker compose -f docker-compose.full.yml up -d
#
# ═══════════════════════════════════════════════════════════════
# QUICK-START (minimum required)
# ═══════════════════════════════════════════════════════════════
#   HOSTNAME              — public hostname (e.g. voice.innotel.us)
#   SESSION_SECRET        — random 64-char hex (openssl rand -hex 32)
#   VOIPMS_API_USERNAME   — VoIP.ms API email
#   VOIPMS_API_PASSWORD   — VoIP.ms API password
#   VOIPMS_SIP_USER       — sub-account for SIP trunk
#   VOIPMS_SIP_PASS       — sub-account password
#   VOIPMS_MAIN_ACCOUNT   — main account ID (6-digit number)
#   FREEPBX_AMI_SECRET    — strong random string for AMI auth
#   FREEPBX_CLIENT_SECRET — strong random string for OAuth2
#
# Everything else has sensible defaults or is optional.
# ═══════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────
# General
# ──────────────────────────────────────────────────────────────

# Public hostname (used for WebSocket URL, WebRTC, etc.)
# Example: voice.innotel.us
HOSTNAME=voice.innotel.us


# ──────────────────────────────────────────────────────────────
# Session
# ──────────────────────────────────────────────────────────────

# Random secret for session cookie signing. auto-generated if unset,
# but setting one explicitly keeps sessions valid across restarts.
# Generate: openssl rand -hex 32
SESSION_SECRET=


# ──────────────────────────────────────────────────────────────
# VoIP.ms (SIP trunk + REST API)
# ──────────────────────────────────────────────────────────────

# Your VoIP.ms API credentials (email + password).
# Get these at: https://voip.ms/m/apidocs.php
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=

# Optional shared secret for incoming SMS webhook verification.
# The webhook URL passes ?token= as a GET param.
VOIPMS_WEBHOOK_SECRET=

# Sub-account for SIP trunk registration (PJSIP).
# The sub-account must have "Device type: IP Auth" or provide SIP creds.
VOIPMS_SIP_USER=235662_pjsip
VOIPMS_SIP_PASS=
VOIPMS_SIP_SERVER=newyork1.voip.ms

# Main VoIP.ms account ID (6-digit number, used for trunk setup).
VOIPMS_MAIN_ACCOUNT=235662


# ──────────────────────────────────────────────────────────────
# FreePBX / Asterisk (internal Docker network)
# ──────────────────────────────────────────────────────────────
# These are passed into both the freepbx container AND the portal
# container. In the full-stack compose, they connect over the
# internal pbx-net Docker network — no external DNS needed.

# ── AMI (Asterisk Manager Interface) ─────────────────────────
# The portal connects to Asterisk AMI for real-time call monitoring
# and CDR collection. These credentials are auto-configured in
# /etc/asterisk/manager_custom.conf on container start.
#
# The username defaults to "pbxportal" if unset.
FREEPBX_AMI_USER=pbxportal
FREEPBX_AMI_SECRET=

# ── OAuth2 API client ────────────────────────────────────────
# The portal uses FreePBX's GraphQL API (extension mgmt, voicemail)
# via OAuth2 client_credentials grant. These credentials are
# auto-registered in the api_applications table on container start.
#
# The client_id defaults to "pbxportal-api" if unset.
FREEPBX_CLIENT_ID=pbxportal-api
FREEPBX_CLIENT_SECRET=


# ──────────────────────────────────────────────────────────────
# WebRTC Softphone (PJSIP WebSocket + TURN)
# ──────────────────────────────────────────────────────────────

# WebSocket URL for browser-based softphone. The freepbx container
# listens on port 8089 for WSS connections.
# Default: wss://<HOSTNAME>:8089/ws
# NEXT_PUBLIC_FREEPBX_WSS_URL=wss://voice.innotel.us:8089/ws

# ── TURN server (NAT traversal for WebRTC) ────────────────────
# Optional but recommended for users behind symmetric NAT.
# Leave empty to skip (softphone may fail on some networks).
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=


# ──────────────────────────────────────────────────────────────
# AvantFax (fax web UI)
# ──────────────────────────────────────────────────────────────
# AvantFax 3.4.1 runs inside the freepbx container via PHP 7.4 FPM,
# served at /fax on port 80. The portal connects to it automatically.
# No separate service or env vars needed.
#
# AVANTFAX_DB_PASS=      # Auto-generated if unset
# FAX_EMAIL=fax@innotel.us
# FAX_NUMBER=7745057136
# Atlas Platform (cross-system provisioning)
# ──────────────────────────────────────────────────────────────
# Optional. If set, the portal notifies Atlas about new signups
# for centralized provisioning. Safe to leave empty.
ATLAS_API_URL=http://atlas-server:3000
ATLAS_API_KEY=


# ──────────────────────────────────────────────────────────────
# Stripe (billing / payments)
# ──────────────────────────────────────────────────────────────
# Get these at: https://dashboard.stripe.com/apikeys
# Leave empty to skip billing (portal works without it).
STRIPE_SECRET_KEY=
STRIPE_CONSUMER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public key — exposed to the browser. Safe to commit.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# ──────────────────────────────────────────────────────────────
# Email (SMTP for voicemail/invoice/fax notifications)
# ──────────────────────────────────────────────────────────────
# Required for: voicemail-to-email, invoice receipts, fax confirmations.
# Use your mail relay (mail.innotel.us) or a service like Resend/SendGrid.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=pbx@innotel.us
SMTP_SECURE=false

# Admin email for system notifications.
ADMIN_EMAIL=admin@innotel.us


# ──────────────────────────────────────────────────────────────
# Public URL
# ──────────────────────────────────────────────────────────────
# Used by the portal for callback URLs and redirects.
# The compose file infers this from HOSTNAME.
# NEXT_PUBLIC_URL=https://<HOSTNAME>:3000
