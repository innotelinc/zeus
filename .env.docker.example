# ═══════════════════════════════════════════════════════════════
# Innotel PBX — Full Stack Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.docker.example .env
# ═══════════════════════════════════════════════════════════════

# ── Hostname ──────────────────────────────────────────────────
HOSTNAME=voice.innotel.us

# ── Session ───────────────────────────────────────────────────
# SESSION_SECRET is auto-generated if unset (persisted to disk).
# Set explicitly to survive volume wipes or share across replicas.
# SESSION_SECRET=
# Set to true only when the portal is accessed via HTTPS/TLS.
# Default false — required for plain HTTP (Docker internal / reverse proxy).
SESSION_SECURE=false

# ── VoIP.ms ───────────────────────────────────────────────────
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
VOIPMS_WEBHOOK_SECRET=
VOIPMS_SIP_USER=
VOIPMS_SIP_PASS=
VOIPMS_SIP_SERVER=newyork1.voip.ms
VOIPMS_MAIN_ACCOUNT=

# ── FreePBX (internal Docker network) ─────────────────────────
FREEPBX_CLIENT_ID=pbxportal-api
FREEPBX_CLIENT_SECRET=
FREEPBX_AMI_USER=pbxportal
FREEPBX_AMI_SECRET=

# ── AvantFax (runs inside freepbx container at /fax) ──────────
# No separate env vars needed — DB password is auto-generated.

# ── SMTP (voicemail-to-email, fax notifications) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=pbx@innotel.us
SMTP_SECURE=false
ADMIN_EMAIL=admin@innotel.us

# ── Stripe billing ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONSUMER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── WebRTC / TURN ─────────────────────────────────────────────
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Atlas integration (AI call analytics) ─────────────────────
ATLAS_API_URL=http://atlas-server:3000
ATLAS_API_KEY=
