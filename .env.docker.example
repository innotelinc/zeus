# ═══════════════════════════════════════════════════════════════
# Zeus — VOIP Platform Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.docker.example .env
# Used by docker-compose.yml (portal), docker-compose.full.yml (full stack)
# and docker-compose.platform.yml (Authentik).
# ═══════════════════════════════════════════════════════════════

# ── Hostname ──────────────────────────────────────────────────
# Public hostname of the FreePBX/PBX service (proxied as pbx.<domain>).
HOSTNAME=pbx.zeus.innotel.us

# ── Session ───────────────────────────────────────────────────
# SESSION_SECRET is auto-generated if unset (persisted to disk).
# Set explicitly to survive volume wipes or share across replicas.
# SESSION_SECRET=
# Set to true only when the portal is accessed via HTTPS/TLS directly
# (not through NPM) — NPM terminates TLS, so keep false behind it.
SESSION_SECURE=false

# ── Authentik (SSO / identity provider — docker-compose.platform.yml) ──
# setup.sh auto-generates these on a fresh install (openssl rand hints below):
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key   # openssl rand -base64 36
AUTHENTIK_TOKEN=change-me-authentik-token             # openssl rand -base64 48
AUTHENTIK_POSTGRES_PASSWORD=change-me-authentik-pg    # openssl rand -base64 36
AUTHENTIK_REDIS_PASSWORD=change-me-authentik-redis    # openssl rand -hex 32
# Bootstrap superuser created on first boot of the platform compose.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@zeus.innotel.us
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-admin
# Pin the Authentik image version.
AUTHENTIK_VERSION=2025.6.3
# ── Portal ↔ Authentik OIDC ──
# Application endpoint = https://auth.<NPM_BASE_DOMAIN>/application/o/<slug>.
# Register the redirect URI https://app.<NPM_BASE_DOMAIN>/api/auth/authentik/callback
# in the Authentik application.
AUTHENTIK_ISSUER_URL=https://auth.zeus.innotel.us/application/o/zeus
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ADMIN_EMAILS=admin@zeus.innotel.us
# Which sign-in paths the portal offers: authentik | freepbx | both.
# Empty = auto: "authentik" when the OIDC vars are set, else "freepbx".
AUTH_MODE=

# ── Nginx Proxy Manager automation (scripts/npm-proxy-hosts.py) ──
# Reverse-proxy front-end. NPM runs on the host (web UI on port 81) and the
# script provisions every canonical zeus.innotel.us subdomain via its API:
#   app/api/portal/auth/pbx/admin/ws.<NPM_BASE_DOMAIN>
NPM_API_URL=http://127.0.0.1:81
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=change-me-npm-password
# Or a persistent API token (NPM → Access → API Tokens) instead:
# NPM_API_TOKEN=
NPM_BASE_DOMAIN=zeus.innotel.us
# Docker host IP NPM forwards to (must be reachable from NPM's container)
# NPM_UPSTREAM_HOST=192.168.1.47
NPM_LETSENCRYPT_EMAIL=admin@zeus.innotel.us
# One wildcard *.zeus.innotel.us cert via DNS-01 (TSIG) attached to every host
NPM_WILDCARD_CERT=1
NPM_DNS_PROVIDER=rfc2136
# TSIG key for RFC 2136 dynamic DNS updates — the sync script provisions the
# NPM DNS credential AND the wildcard certificate automatically from these
# (zero manual NPM clicks). Your DNS server must accept RFC 2136 updates
# signed with this key. Key secret is base64.
NPM_TSIG_NAMESERVER=192.0.2.1          # host or host:port
NPM_TSIG_KEY_NAME=zeus.
NPM_TSIG_KEY_SECRET=
NPM_TSIG_ALGORITHM=HMAC-SHA256
# Alternative to the TSIG vars: raw provider credentials content (or a path
# to a credentials file) for NPM_DNS_PROVIDER.
# NPM_DNS_PROVIDER_CREDENTIALS=

# ── VoIP.ms ───────────────────────────────────────────────────
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
VOIPMS_WEBHOOK_SECRET=
VOIPMS_SIP_USER=
VOIPMS_SIP_PASS=
VOIPMS_SIP_SERVER=newyork1.voip.ms
VOIPMS_MAIN_ACCOUNT=

# ── FreePBX (internal Docker network) ─────────────────────────
FREEPBX_CLIENT_ID=pbxportal-api
FREEPBX_CLIENT_SECRET=
FREEPBX_AMI_USER=pbxportal
FREEPBX_AMI_SECRET=

# Database password for the FreePBX MariaDB user. Leave EMPTY on a fresh
# install — the image's own generated password is correct and is used as-is.
# Set it ONLY when the freepbx container starts against a pbx-mariadb-data
# volume another build created (a Zeus image upgrade, or the Capstone add-on's
# bundled FreePBX you are taking the voice plane over from): the image bakes a
# random AMPDBPASS per build, so the volume's password differs and every
# `fwconsole` call dies with "Access denied for user 'freepbxuser'@'localhost'"
# while Asterisk keeps running. docker-entrypoint-full.sh then reconciles both
# the container's /etc/freepbx.conf and the MariaDB grant to this value, which
# leaves the volume's own credentials untouched (so the hand-off stays
# reversible in either direction).
# Read the existing password out of the volume's own image:
#   docker run --rm --entrypoint bash <old-image> -c "grep AMPDBPASS /etc/freepbx.conf"
PBX_DB_PASS=

# ── AvantFax (runs inside freepbx container at /fax) ──────────
# No separate env vars needed — DB password is auto-generated.

# ── SMTP (voicemail-to-email, fax notifications) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=pbx@zeus.innotel.us
SMTP_SECURE=false
ADMIN_EMAIL=admin@zeus.innotel.us

# ── Stripe billing ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONSUMER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── WebRTC / TURN ─────────────────────────────────────────────
# coturn runs as this stack's `coturn` service and is the ONE TURN server both
# products use — that pair (username/credential) is shared by coturn, Asterisk
# and every browser the portals hand it to, so it must be written to FreePBX's
# settings DB as well (docker-entrypoint-full.sh does that; the DB copy is what
# regenerates rtp_additional.conf on Apply Config).
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
# Host port coturn is published on (the container itself stays on 3478). Must
# match the router forward. Also builds Asterisk's stunaddr (coturn:<port>).
TURN_LISTENING_PORT=3478
# Auth realm coturn advertises. Any stable string works; keep it fixed, because
# browsers that cached a realm have to re-auth when it changes.
TURN_REALM=
# UDP relay range. These ports MUST be published (see the coturn service in
# docker-compose*.yml) or only the TURN control channel is reachable and every
# relayed call is silent.
TURN_RELAY_PORT_START=49152
TURN_RELAY_PORT_END=49251
# Public address coturn advertises for relayed candidates. Leave empty and the
# container detects it per start via the image's detect-external-ip (correct on
# a dynamic WAN IP, which is the common case). Set it only where that probe is
# blocked by DNS policy — a pinned address silently rots when the WAN changes
# and calls then connect with no audio.
TURN_EXTERNAL_IP=

# ── RTP media (Asterisk) ──────────────────────────────────────
# The RTP plane Zeus owns: every consumer — Zeus softphones/portal and the
# Capstone agent add-on — rides this one range. The same values are published
# by the freepbx service in docker-compose.full.yml, capped into
# /etc/asterisk/rtp_custom.conf, and written into FreePBX's kvstore_Sipsettings
# by docker-entrypoint-full.sh (that DB copy is what regenerates
# rtp_additional.conf on Apply Config). All three must agree, or media silently
# escapes the published ports and calls go one-way.
# Keep Webmin (TCP 10000) and the TURN relay range out of this block. The two
# sides of the compose mapping must stay the same length (the container side is
# fixed at 10101-10120 — what Asterisk binds).
FREEPBX_RTP_PORT_START=10101
FREEPBX_RTP_PORT_END=10120
# STUN/TURN address Asterisk's RTP engine uses. Empty -> the local coturn
# compose service (coturn:<TURN_LISTENING_PORT>). Set it when that alias is not
# resolvable from the PBX container (e.g. a remote TURN host, or 127.0.0.1 on a
# bare-metal install). Never host.docker.internal — Asterisk's resolver fails
# on it and silently disables STUN.
# PJSIP_STUN_TURN_ADDR=

# ── Atlas integration (AI call analytics) ─────────────────────
ATLAS_API_URL=http://atlas-server:3000
ATLAS_API_KEY=

# ── Public URL ────────────────────────────────────────────────
# Portal origin end users see (NPM proxies app.<domain> → :3000).
NEXT_PUBLIC_URL=https://app.zeus.innotel.us

# ── AI voicemail summaries ────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── White-label branding (optional) ───────────────────────────
# NEXT_PUBLIC_BRAND_NAME=Zeus
# ─── Infisical (SecretOps) ─────────────────────────────────────────
# Innotel Platform Stack: secrets live in Infisical; .env is derived from it.
# Generate the keys with:
#   openssl rand -base64 32   # INFISICAL_ENCRYPTION_KEY
#   openssl rand -hex 16      # INFISICAL_AUTH_SECRET
#   openssl rand -hex 16      # INFISICAL_DB_PASSWORD
# Then: docker compose -f docker-compose.yml -f compose.infisical.yml \
#         --profile infisical up -d
#       bash scripts/infisical-setup.sh
INFISICAL_PORT=8383
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ADMIN_EMAIL=
INFISICAL_ADMIN_PASSWORD=
INFISICAL_ORG=Innotel
# Runtime resolution contract (written back to .env by infisical-setup.py;
# consumed at boot by docker-entrypoint.sh via scripts/infisical-env.mjs —
# docs/stack.md). With these set, secret values in this file may be
# `infisical://<name>` references, e.g.
#   VOIPMS_SIP_PASS=infisical://VOIPMS_SIP_PASS
# Supported keys: SESSION_SECRET, VOIPMS_SIP_PASS, VOIPMS_API_PASSWORD,
# VOIPMS_IAX_PASS, VOIPMS_WEBHOOK_SECRET, FREEPBX_AMI_SECRET,
# ASTERISK_AMI_SECRET, AVANTFAX_WEBHOOK_SECRET, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, TURN_CREDENTIAL. Plain values pass through.
INFISICAL_ADDR=
INFISICAL_TOKEN=
INFISICAL_WORKSPACE_ID=
INFISICAL_ENVIRONMENT=prod
