# ═══════════════════════════════════════════════════════════════
#  Zeus VOIP Platform — Secrets file (bare-metal setup.sh/setup-portal.sh)
# ═══════════════════════════════════════════════════════════════
#  All secrets live in this .env file — never hardcode them in the
#  installers. Copy to pbx.env (next to setup.sh) or point PBX_ENV_FILE
#  at it, then edit the values:
#
#      cp scripts/pbx.env.example scripts/pbx.env
#      nano scripts/pbx.env
#      bash scripts/setup.sh
#
#  The file is sourced by scripts/setup.sh and scripts/setup-portal.sh.
#  NEVER commit it (pbx.env is gitignored).
# ═══════════════════════════════════════════════════════════════

# ── Hostname ──────────────────────────────────────────────────
# Public hostname of this FreePBX server (NPM proxies it as pbx.zeus.innotel.us).
HOSTNAME=pbx.zeus.innotel.us

# ── MariaDB / Asterisk database password (REQUIRED) ───────────
# Used for the MySQL root password, asterisk DB grants, ODBC, AMI,
# code-server, and the AI-CDR DB connection.
DB_PASS=CHANGE_ME

# ── Sendmail relay + AvantFax SMTP password ───────────────────
# Authenticates outbound mail against ${SMTP_HOST}:${SMTP_PORT}.
# Defaults to DB_PASS when left blank.
SMTP_PASS=

# ── Dograh ARI password (Asterisk REST API user) ─────────────
# Used by the ARI "dograh" user + websocket_client. Generated if blank.
DOGRAH_ARI_PASS=

# ── FreePBX API (OAuth2) + AMI credentials for the portal ────
# setup.sh generates random values and prints them when left blank;
# pass the same values to setup-portal.sh.
FREEPBX_AMI_SECRET=
FREEPBX_CLIENT_SECRET=

# ── VoIP.ms trunks (SIP/PJSIP + IAX) ──────────────────────────
VOIPMS_SIP_SERVER=newyork1.voip.ms
VOIPMS_SIP_USER=CHANGE_ME        # e.g. 235662_capstone (sub-account for PJSIP trunk)
VOIPMS_SIP_PASS=CHANGE_ME
VOIPMS_IAX_USER=CHANGE_ME        # e.g. 235662_iax
VOIPMS_IAX_PASS=CHANGE_ME

# ── IAXModem <-> FreePBX peer secret (defaults to 329fax) ─────
IAXMODEM_SECRET=

# ── SMS over PJSIP ────────────────────────────────────────────
# DID numbers that may send/receive SMS over the PJSIP trunk
SMS_DIDS=7745057135 8579901777 4135612020 4132643964 7257807770
# Portal outbound SMS = AMI MessageSend over this trunk (mirrors the sms-out
# dialplan; no VoIP.ms REST per-message fee). Optional overrides:
#   VOIPMS_TRUNK_NAME      default voipms_pjsip (must match setup.sh trunk)
#   SMS_TRUNK_FROM_USER    From URI user part; default = VOIPMS_SIP_USER.
#                          Set to a DID (e.g. 7745057135) if voip.ms requires
#                          the sender to be the DID rather than the sub-account.
# VOIPMS_TRUNK_NAME=voipms_pjsip

# ── Outbound route (pbx/outbound_route.py) ────────────────────
# The route that gives a dialled number the digits the trunk needs. A phone
# dials ten digits (`4134210134`); VoIP.ms terminates a North American call on
# eleven, `1` + area code + number. The route adds that `1` — and the failure
# when it does not is quiet: a route leading with a bare `X.` catch-all matches
# every number and prepends nothing, so the call leaves unnormalised and does
# not complete while the trunk stays registered. Converged on boot by
# `docker-entrypoint-full.sh` / `scripts/setup.sh`, and re-checked every tick
# by `scripts/zeus-pbx-sync.sh`. Rename only if the route on the PBX is not
# called PSTN; the trunk defaults to VOIPMS_TRUNK_NAME.
# PBX_OUTBOUND_ROUTE=PSTN

# ── The portal's routing view, for machine callers ────────────────
# GET /api/admin/voice-routing is the portal's own answer to "which agent does
# each of this account's numbers reach", and accepts this shared token in
# `Authorization: Bearer` instead of an operator session. Set the SAME value in
# the portal's environment (docker-compose.yml / zeus-portal.service) and here.
# Generated if blank by scripts/setup.sh.
#
# Nothing in this repo consumes it any more: the bootstrap used to fetch the
# plan and render a [zeus-ai-accounts] context from it, and that renderer went
# with the AVA engine — a DID now reaches its agent through its own FreePBX
# inbound route (see the [dograh_routes.py] section of pbx/README.md). The key
# is kept because the endpoint is still the machine-readable form of that
# answer for anything that needs it, and a token with no reader is cheaper than
# a 401 discovered later.
PBX_SYNC_TOKEN=
# Portal base URL as reachable from this PBX host (default http://127.0.0.1:3001).
# ZEUS_PORTAL_URL=http://127.0.0.1:3001

# ── Add-on entitlement gate (Magnate) ────────────────────────────────────
# Magnate owns billing; Zeus consumes its decisions for the two voice add-ons.
# Policy matches Capstone's (see src/lib/addons.ts): with MAGNATE_PUBLIC_URL
# unset — or with a SKU's plan slug unset — the gate for that SKU is INACTIVE
# and the product is not withheld. Only an authoritative "no" denies, so a
# billing outage never un-wires a paying customer's lines.
# MAGNATE_PUBLIC_URL=https://app.magnate.innotel.us
# ENTITLEMENTS_API_TOKEN=
# MAGNATE_AGENTS_PLAN=                 # Dograh voice-agent SKU
# MAGNATE_CAPSTONE_PLAN=               # Capstone hand-off SKU
#   MAGNATE_AGENT_PLAN is accepted for the Capstone SKU too — that is the name
#   Capstone's own sync uses, so one variable keeps both products agreeing.

# ── PSTN numbers ─────────────────────────────────────────────────────────────
# DID → dograh agent extension, "did:ext,did:ext". Inbound DIDs land on this
# PBX and are handed to the dograh agent owning the extension.
# VOIPMS_DIDS=4132643964:8000

# ── Cloudonix SIP peering (pbx/setup-cloudonix-trunk.sh) ─────────────────────
# Peers a Cloudonix domain with this PBX so Cloudonix calls arrive over SIP
# instead of Cloudonix's websocket transport. Enabled when
# CLOUDONIX_SIP_ENABLED=1, or automatically once any value below is set.
# CLOUDONIX_SIP_USER/CLOUDONIX_SIP_PASS turn the trunk into a registration
# (NAT-friendly: no inbound 5060 forward needed); without them the edge is
# trusted by IP identity.
# CLOUDONIX_SIP_ENABLED=1
# CLOUDONIX_SIP_SERVER=sip.cloudonix.net
# CLOUDONIX_EDGE_IP=18.219.128.166
# CLOUDONIX_SIP_PORT=5060
# CLOUDONIX_SIP_USER=
# CLOUDONIX_SIP_PASS=
# CLOUDONIX_DIDS=
# SMS_TRUNK_FROM_USER=

# ── Nginx Proxy Manager automation (scripts/npm-proxy-hosts.py) ──
# setup.sh provisions every canonical subdomain (app/api/auth/pbx/portal/
# admin/ws.<NPM_BASE_DOMAIN>) via the NPM REST API once the stack is up.
NPM_API_URL=http://127.0.0.1:81
NPM_ADMIN_EMAIL=
NPM_ADMIN_PASSWORD=
# Or a persistent API token (NPM → Access → API Tokens):
# NPM_API_TOKEN=
NPM_BASE_DOMAIN=zeus.innotel.us
# Docker host IP NPM forwards to (the FreePBX server's LAN IP)
# NPM_UPSTREAM_HOST=192.168.1.47
# Host running Authentik. It is part of the Cerulean trust plane, not this
# stack, so auth.<NPM_BASE_DOMAIN> must keep pointing at it even when the
# stack (and NPM_UPSTREAM_HOST) moves to another machine.
# AUTHENTIK_UPSTREAM_HOST=192.168.1.46
NPM_LETSENCRYPT_EMAIL=admin@zeus.innotel.us
# One wildcard *.zeus.innotel.us Let's Encrypt cert via DNS-01 (TSIG).
# The TSIG key below lets setup.sh provision the NPM DNS credential and the
# wildcard certificate automatically — zero manual NPM clicks. Your DNS
# server must accept RFC 2136 updates signed with this key.
NPM_WILDCARD_CERT=1
NPM_DNS_PROVIDER=rfc2136
NPM_TSIG_NAMESERVER=192.0.2.1          # host or host:port
NPM_TSIG_KEY_NAME=zeus.
NPM_TSIG_KEY_SECRET=
NPM_TSIG_ALGORITHM=HMAC-SHA256
# Alternative to the TSIG vars: raw provider credentials content (or file path).
# NPM_DNS_PROVIDER_CREDENTIALS=

# ── MS Teams Direct Routing — Cerulean trust plane (pbx/cerulean-msteams.sh) ──
# MS Teams Direct Routing needs a publicly resolvable SBC FQDN and an RSA-2048
# TLS cert. Cerulean (the stack's TrustOps platform) owns DNS + ACME: the
# adapter asks Cerulean to upsert the SBC A record and issue the cert via
# DNS-01, then pbx/MSTeams-DR-Wizard.sh consumes it Asterisk-side.
#
# RECOMMENDED — API mode (Cerulean does the BIND nsupdate + ACME server-side):
# CERULEAN_API_URL=https://api.cerulean.innotel.us
# CERULEAN_API_PASSWORD=        # Cerulean admin password (or paste a token)
# CERULEAN_API_TOKEN=           # optional: bearer token, skips login
# CERULEAN_TENANT=              # optional: tenant slug (X-Cerulean-Tenant)
#
# DIRECT mode fallback (no API reachable): this host nsupdates BIND and runs
# certbot itself. Every CERULEAN_TSIG_* falls back to its NPM_TSIG_* twin
# above, so one key drives both tools.
# CERULEAN_SBC_FQDN=teams.zeus.innotel.us     # default: HOSTNAME from this file
# CERULEAN_ZONE=zeus.innotel.us               # default: FQDN minus first label
# CERULEAN_TSIG_NAMESERVER=192.0.2.1          # default: NPM_TSIG_NAMESERVER
# CERULEAN_TSIG_KEY_NAME=zeus.                # default: NPM_TSIG_KEY_NAME
# CERULEAN_TSIG_KEY_SECRET=                   # default: NPM_TSIG_KEY_SECRET
# CERULEAN_TSIG_ALGORITHM=HMAC-SHA256         # default: NPM_TSIG_ALGORITHM
# CERULEAN_LE_EMAIL=admin@zeus.innotel.us     # default: NPM_LETSENCRYPT_EMAIL
# MS_TEAMS_SBC_IP=203.0.113.42                # public IPv4 for the A record; auto-detected when unset

# ── PBX Portal secrets (consumed by setup-portal.sh) ──────────
SESSION_SECRET=CHANGE_ME
ATLAS_API_KEY=CHANGE_ME
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Portal ↔ Authentik OIDC (SSO — see docker-compose.platform.yml)
AUTHENTIK_ISSUER_URL=https://auth.zeus.innotel.us/application/o/zeus
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ADMIN_EMAILS=admin@zeus.innotel.us