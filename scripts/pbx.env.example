# ═══════════════════════════════════════════════════════════════
#  Zeus VOIP Platform — Secrets file (bare-metal setup.sh/setup-portal.sh)
# ═══════════════════════════════════════════════════════════════
#  All secrets live in this .env file — never hardcode them in the
#  installers. Copy to pbx.env (next to setup.sh) or point PBX_ENV_FILE
#  at it, then edit the values:
#
#      cp scripts/pbx.env.example scripts/pbx.env
#      nano scripts/pbx.env
#      bash scripts/setup.sh
#
#  The file is sourced by scripts/setup.sh and scripts/setup-portal.sh.
#  NEVER commit it (pbx.env is gitignored).
# ═══════════════════════════════════════════════════════════════

# ── Hostname ──────────────────────────────────────────────────
# Public hostname of this FreePBX server (NPM proxies it as pbx.zeus.innotel.us).
HOSTNAME=pbx.zeus.innotel.us

# ── MariaDB / Asterisk database password (REQUIRED) ───────────
# Used for the MySQL root password, asterisk DB grants, ODBC, AMI,
# code-server, and the AI-CDR DB connection.
DB_PASS=CHANGE_ME

# ── Sendmail relay + AvantFax SMTP password ───────────────────
# Authenticates outbound mail against ${SMTP_HOST}:${SMTP_PORT}.
# Defaults to DB_PASS when left blank.
SMTP_PASS=

# ── Dograh ARI password (Asterisk REST API user) ─────────────
# Used by the ARI "dograh" user + websocket_client. Generated if blank.
DOGRAH_ARI_PASS=

# ── FreePBX API (OAuth2) + AMI credentials for the portal ────
# setup.sh generates random values and prints them when left blank;
# pass the same values to setup-portal.sh.
FREEPBX_AMI_SECRET=
FREEPBX_CLIENT_SECRET=

# ── VoIP.ms trunks (SIP/PJSIP + IAX) ──────────────────────────
VOIPMS_SIP_SERVER=newyork1.voip.ms
VOIPMS_SIP_USER=CHANGE_ME        # e.g. 235662_pjsip
VOIPMS_SIP_PASS=CHANGE_ME
VOIPMS_IAX_USER=CHANGE_ME        # e.g. 235662_iax
VOIPMS_IAX_PASS=CHANGE_ME

# ── IAXModem <-> FreePBX peer secret (defaults to 329fax) ─────
IAXMODEM_SECRET=

# ── SMS over PJSIP ────────────────────────────────────────────
# DID numbers that may send/receive SMS over the PJSIP trunk
SMS_DIDS=7745057135 8579901777 4135612020 4132643964 7257807770

# ── Nginx Proxy Manager automation (scripts/npm-proxy-hosts.py) ──
# setup.sh provisions every canonical subdomain (app/api/auth/pbx/portal/
# admin/ws.<NPM_BASE_DOMAIN>) via the NPM REST API once the stack is up.
NPM_API_URL=http://127.0.0.1:81
NPM_ADMIN_EMAIL=
NPM_ADMIN_PASSWORD=
# Or a persistent API token (NPM → Access → API Tokens):
# NPM_API_TOKEN=
NPM_BASE_DOMAIN=zeus.innotel.us
# Docker host IP NPM forwards to (the FreePBX server's LAN IP)
# NPM_UPSTREAM_HOST=192.168.1.47
NPM_LETSENCRYPT_EMAIL=admin@zeus.innotel.us
# One wildcard *.zeus.innotel.us Let's Encrypt cert via DNS-01 (TSIG).
# The TSIG key below lets setup.sh provision the NPM DNS credential and the
# wildcard certificate automatically — zero manual NPM clicks. Your DNS
# server must accept RFC 2136 updates signed with this key.
NPM_WILDCARD_CERT=1
NPM_DNS_PROVIDER=rfc2136
NPM_TSIG_NAMESERVER=192.0.2.1          # host or host:port
NPM_TSIG_KEY_NAME=zeus.
NPM_TSIG_KEY_SECRET=
NPM_TSIG_ALGORITHM=HMAC-SHA256
# Alternative to the TSIG vars: raw provider credentials content (or file path).
# NPM_DNS_PROVIDER_CREDENTIALS=

# ── PBX Portal secrets (consumed by setup-portal.sh) ──────────
SESSION_SECRET=CHANGE_ME
ATLAS_API_KEY=CHANGE_ME
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Portal ↔ Authentik OIDC (SSO — see docker-compose.platform.yml)
AUTHENTIK_ISSUER_URL=https://auth.zeus.innotel.us/application/o/zeus
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ADMIN_EMAILS=admin@zeus.innotel.us