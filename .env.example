# ── Required ──

# Auto-generated if not set
SESSION_SECRET=

# ── VoIP.ms ──
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=

# ── FreePBX ──
FREEPBX_URL=
FREEPBX_CLIENT_ID=
FREEPBX_CLIENT_SECRET=
# Asterisk AMI (Manager Interface) for real-time call monitoring
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_SECRET=
# WebSocket URL for WebRTC softphone (e.g. wss://voice.innotel.us:8089/ws)
FREEPBX_WSS_URL=
NEXT_PUBLIC_FREEPBX_WSS_URL=
# TURN server for WebRTC (needed for users behind NAT)
NEXT_PUBLIC_TURN_SERVER=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── AvantFax ──
AVANTFAX_URL=
NEXT_PUBLIC_AVANTFAX_URL=
AVANTFAX_DB_PATH=

# ── Atlas integration ──
ATLAS_API_URL=http://localhost:3000
ATLAS_API_KEY=

# ── Stripe (billing) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Public URL ──
NEXT_PUBLIC_URL=http://localhost:3001

# ── Node ──
NODE_ENV=development
