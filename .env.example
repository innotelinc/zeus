[TEMPLATE]
# ── Required ──

# Auto-generated if not set
SESSION_SECRET=

# ── Authentik (SSO / identity provider) ──
# With all three set, password login is disabled and every sign-in goes
# through Authentik (see README → Authentik SSO).
AUTHENTIK_ISSUER_URL=https://auth.zeus.innotel.us/application/o/zeus
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Emails granted the admin role (comma-separated)
AUTHENTIK_ADMIN_EMAILS=admin@zeus.innotel.us

# ── VoIP.ms ──
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
# Optional shared secret for webhook verification (GET ?token=)
VOIPMS_WEBHOOK_SECRET=

# VoIP.ms sub-account for SIP trunk (PJSIP registration)
VOIPMS_SIP_USER=235662_pjsip
VOIPMS_SIP_PASS=
VOIPMS_SIP_SERVER=newyork1.voip.ms
VOIPMS_MAIN_ACCOUNT=235662

# ── FreePBX ──
FREEPBX_URL=
FREEPBX_CLIENT_ID=
FREEPBX_CLIENT_SECRET=
# Asterisk AMI (Manager Interface) for real-time call monitoring
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_SECRET=
# WebSocket URL for WebRTC softphone (e.g. wss://ws.zeus.innotel.us:8089/ws)
FREEPBX_WSS_URL=
NEXT_PUBLIC_FREEPBX_WSS_URL=
# TURN server for WebRTC (needed for users behind NAT)
NEXT_PUBLIC_TURN_SERVER=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── AvantFax ──
AVANTFAX_URL=
NEXT_PUBLIC_AVANTFAX_URL=
AVANTFAX_DB_PATH=
AVANTFAX_WEBHOOK_SECRET=

# ── Atlas integration ──
ATLAS_API_URL=http://localhost:3000
ATLAS_API_KEY=

# ── Stripe (billing) ──
STRIPE_SECRET_KEY=
STRIPE_CONSUMER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email (SMTP for voicemail forwarding) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=pbx@zeus.innotel.us
SMTP_SECURE=false

# ── Public URL ──
NEXT_PUBLIC_URL=https://app.zeus.innotel.us

# ── AI voicemail summaries (local LLM) ──
# Ollama endpoint the portal calls to summarise voicemail transcripts.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── White-label branding (optional) ──
# Overrides the platform brand everywhere in the UI/emails; reseller domains
# set per-user automatically (Admin → Resellers).
NEXT_PUBLIC_BRAND_NAME=Zeus
# ─── Infisical (SecretOps) ─────────────────────────────────────────
# Innotel Platform Stack: secrets live in Infisical; .env is derived from it.
# Generate the keys with:
#   openssl rand -base64 32   # INFISICAL_ENCRYPTION_KEY
#   openssl rand -hex 16      # INFISICAL_AUTH_SECRET
#   openssl rand -hex 16      # INFISICAL_DB_PASSWORD
# Then: docker compose -f docker-compose.yml -f compose.infisical.yml \
#         --profile infisical up -d
#       bash scripts/infisical-setup.sh
INFISICAL_PORT=8383
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ADMIN_EMAIL=
INFISICAL_ADMIN_PASSWORD=
INFISICAL_ORG=Innotel
