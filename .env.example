# ── Required ──

# Auto-generated if not set
SESSION_SECRET=

# ── Authentik (SSO / identity provider) ──
# With all three set, sign-in goes through Authentik (see README → Authentik SSO).
AUTHENTIK_ISSUER_URL=https://auth.zeus.innotel.us/application/o/zeus
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Which sign-in paths the portal offers:
#   authentik = SSO only (password login disabled)
#   freepbx   = local password login only
#   both      = Authentik button + password form
# Empty = auto: "authentik" when the OIDC vars above are set, else "freepbx".
AUTH_MODE=
# Emails granted the admin role (comma-separated)
AUTHENTIK_ADMIN_EMAILS=admin@zeus.innotel.us

# ── VoIP.ms ──
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
# Optional shared secret for webhook verification (GET ?token=)
VOIPMS_WEBHOOK_SECRET=

# VoIP.ms sub-account for SIP trunk (PJSIP registration).
# The account's real sub-accounts are 235662_capstone / 235662_iax / 235662_pjsip
# (list via VoIP.ms REST getSubAccounts); the capstone trunk carries the voice plane.
VOIPMS_SIP_USER=235662_capstone
VOIPMS_SIP_PASS=
VOIPMS_SIP_SERVER=newyork1.voip.ms
VOIPMS_MAIN_ACCOUNT=235662
# FreePBX SMS transport (outbound SMS = AMI MessageSend over the PJSIP trunk,
# NOT the paid VoIP.ms REST sendSMS). SMS_TRUNK_FROM_USER overrides the From
# URI user part (default: VOIPMS_SIP_USER, matching the sms-out dialplan).
# VOIPMS_TRUNK_NAME defaults to voipms_pjsip when unset.
# SMS_TRUNK_FROM_USER=

# ── FreePBX ──
FREEPBX_URL=http://freepbx
FREEPBX_CLIENT_ID=
FREEPBX_CLIENT_SECRET=
# Asterisk AMI (Manager Interface) for real-time call monitoring
ASTERISK_AMI_HOST=zeus-freepbx
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_SECRET=
# Credential for the call-context read (GET /api/voice/context/{token}) — the
# endpoint the hand-off uses to learn which account and caller it has just
# been given. Its callers are machines: Capstone at the hand-off and Dograh at
# the hand-back. `openssl rand -hex 32`, and give the same value to them (see
# docs/voice-convergence.md, D2). Unset = the route refuses every read.
VOICE_CONTEXT_SECRET=
# WebSocket URL for WebRTC softphone (e.g. wss://ws.zeus.innotel.us:8089/ws)
FREEPBX_WSS_URL=
NEXT_PUBLIC_FREEPBX_WSS_URL=
# ── TURN (coturn) — needed for calls to carry audio from behind NAT ──
# Space- or comma-separated list; the browser tries them in order. `turn:` is
# UDP (lowest latency) and `turns:` is TCP on the TLS port, which survives
# networks that filter UDP — list both where the router forwards both:
#   TURN_SERVER=turn:coturn.zeus.innotel.us:3478,turns:coturn.zeus.innotel.us:5349
# These reach the browser through GET /api/rtc-config (server-side, at request
# time) rather than being compiled into the portal bundle, so changing them is
# a restart, not an image rebuild. Keep `turn:` on a line that fits the relay
# below: relayed media is a separate UDP flow the router has to deliver.
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
# Realm advertised to clients; the public IP or the domain both work.
TURN_REALM=zeus.innotel.us
# Listening + TLS ports, and the UDP relay range coturn allocates media ports
# from. Publish/forward all of them: TURN_LISTENING_PORT (control, UDP),
# TURN_TLS_PORT (control, TCP/TLS), and the whole range (media).
TURN_LISTENING_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_PORT_START=49152
TURN_RELAY_PORT_END=49251
# Public address coturn advertises for relayed candidates; empty means the
# image's detect-external-ip probe runs on every start (right for a changing
# residential WAN address). Pin it only where that probe is blocked.
TURN_EXTERNAL_IP=
# scripts/install-turn-cert.sh places the wildcard fullchain/privkey that TLS
# needs at data/coturn/certs; scripts/edge-turn-relay.sh forwards the router's
# TURN ports on if they still point at this platform's old host.

# ── AvantFax ──
AVANTFAX_URL=http://freepbx/fax
NEXT_PUBLIC_AVANTFAX_URL=https://pbx.zeus.innotel.us/fax
AVANTFAX_DB_PATH=
AVANTFAX_WEBHOOK_SECRET=

# ── Atlas integration ──
ATLAS_API_URL=http://192.168.1.46:3004
ATLAS_API_KEY=

# ── Stripe (billing) ──
# LEGACY: leave empty when Magnate owns billing (the default). Magnate is
# the single billing platform for the entire Innotel ecosystem.
# See https://github.com/innotelinc/magnate
STRIPE_SECRET_KEY=
STRIPE_CONSUMER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Magnate (RevenueOps) — billing & entitlements ──
# Innotel Platform Stack: Zeus does NOT own billing — Magnate does.
# Point at the shared Magnate instance for subscription checks and
# entitlement gating. Leave empty when running standalone (no billing).
MAGNATE_PUBLIC_URL=
# The ecosystem's subscribe portal (the portal landing + subscribing page for
# every Innotel service). Zeus links to it as "see all plans".
MAGNATE_SUBSCRIBE_URL=https://subscribe.innotel.us

# ── Email (SMTP for voicemail forwarding) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=pbx@zeus.innotel.us
SMTP_SECURE=false

# ── Public URL ──
NEXT_PUBLIC_URL=https://app.zeus.innotel.us

# ── AI voicemail summaries (pinned model) ───────────────────────
# The endpoint the portal calls to summarise voicemail transcripts. In the
# deployment this is the shared gateway's Ollama-compatible surface; a plain
# Ollama is the fallback for a single-box install. VOICEMAIL_SUMMARY_URL falls
# back to OLLAMA_URL, then to loopback.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# The summary model is pinned SEPARATELY from the call path's. The gateway's
# free routes cooldown per model, so sharing one would let a busy call path
# silence summaries — and a busy voicemail box would starve calls. Pin a model
# that answers in the provider's LIVE catalogue: an id can be listed while the
# upstream provider 400s or 429s it.
# Falls back to OLLAMA_MODEL when unset. Asserted by `pbx/d7_assert.py`.
# VOICEMAIL_SUMMARY_URL=http://192.168.1.46:20129
# VOICEMAIL_SUMMARY_MODEL=gemini/gemini-3.1-flash-lite

# ── White-label branding (optional) ──
# Overrides the platform brand everywhere in the UI/emails; reseller domains
# set per-user automatically (Admin → Resellers).
NEXT_PUBLIC_BRAND_NAME=Zeus
# ─── Cerulean Vault (SecretOps) ────────────────────────────────────
# The platform's only secret store: HashiCorp Vault (KV v2), hosted by
# Cerulean. Values live there, and .env may name one with a reference:
#
#   VOIPMS_SIP_PASS=vault://cerulean/zeus#VOIPMS_SIP_PASS
#
# docker-entrypoint.sh resolves those references at container startup — before
# the Next.js server boots — via scripts/vault-env.mjs, so every consumer reads
# the plain value from process.env. A reference that cannot be resolved aborts
# the container instead of booting with a literal `vault://` value, and a
# leftover `infisical://` reference is refused (Infisical is retired here).
#
# Cerulean's Vault bootstrap mints this stack's path-scoped token
# (VAULT_PRODUCT_TOKENS=zeus there) and writes it to
# ./data/vault/token/zeus.token; copy that file in, then move any plaintext
# values across with scripts/vault-migrate.py:
#
#   VAULT_ADDR=http://<cerulean-host>:8200 \
#     VAULT_TOKEN_FILE=./data/vault/token/zeus.token \
#     VAULT_PREFIX=cerulean VAULT_PATH=zeus \
#     python3 scripts/vault-migrate.py --from-env-file .env \
#       --keys VOIPMS_SIP_PASS,TURN_CREDENTIAL
#
# Resolvable keys: SESSION_SECRET, VOIPMS_SIP_PASS, VOIPMS_API_USERNAME,
# VOIPMS_API_PASSWORD, VOIPMS_IAX_PASS, VOIPMS_WEBHOOK_SECRET,
# FREEPBX_AMI_SECRET, ASTERISK_AMI_SECRET, AVANTFAX_WEBHOOK_SECRET,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, TURN_CREDENTIAL.
# Plain values pass through untouched.
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/zeus.token
VAULT_PREFIX=cerulean
VAULT_PATH=zeus
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=
# ─── Observability ────────────────────────────────────────────
# Two ways to get portal spans, and you pick one:
#
#   a) the bundled SigNoz profile (a host that does NOT run Capstone):
#        docker compose -f docker-compose.yml -f compose.observability.yml up -d
#        — the profile sets OTEL_EXPORTER_OTLP_ENDPOINT for you.
#   b) an external collector, i.e. Capstone's SigNoz (the co-hosted box):
#        docker compose -f docker-compose.yml \
#                       -f compose.observability.external.yml up -d
#        — set OTEL_EXTERNAL_COLLECTOR to Capstone's OTLP ingest.
#
# Unset everywhere means the tracer is a no-op: no socket, no spans, no
# dependency. Leave it alone until you want traces (docs/stack.md).
# SIGNOZ_POSTGRES_PASSWORD=      # openssl rand -hex 16   (profile a only)
# SIGNOZ_JWT_SECRET=             # openssl rand -hex 32   (profile a only)
# OTEL_EXTERNAL_COLLECTOR=http://192.168.1.30:4318        (mode b only)
# OTEL_SERVICE_NAME=zeus-portal
# OTEL_SERVICE_VERSION=
# OTEL_DEPLOYMENT_ENVIRONMENT=zeus
# OTEL_TRACES_ENABLED=            # "false" forces spans off even when a collector is set
# OTEL_EXPORT_INTERVAL_MS=5000
# OTEL_EXPORTER_OTLP_HEADERS=     # k=v,k=v — only if the collector is behind an auth gate

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ------------
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform, and hosts the Authentik SSO
# (OIDC) identity provider used by the Zeus portal login.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us

# Reasoning goes to the estate's canonical gateway (192.168.1.46:20129, the
# oauth2-proxy door), never to a cloud API directly. OMNIROUTE_API_KEY is the
# same key the rest of the stack uses.
OMNIROUTE_API_KEY=

# ── Dograh: the voice plane, and the only engine ──────────────────────
# The portal reads the voice plane through Dograh's HTTP API. `dograh-api`
# runs `network_mode: host` on the voice host, so 127.0.0.1:8000 is the
# address when the portal shares that host — override it for a split
# deployment (or reach it over the LAN as http://192.168.1.30:8000).
#
# DOGRAH_API_KEY is a Dograh service key, sent as `X-API-Key`. Blank means
# the Voice screens report "not configured" rather than failing. On the
# full-stack host it is the same value as Capstone's DOGRAH_API_TOKEN.
DOGRAH_API_URL=http://127.0.0.1:8000
DOGRAH_API_KEY=
# The Dograh UI, for the System Map's links out. A PUBLIC hostname on
# purpose: the link is opened by a browser, which cannot reach this host's
# loopback.
DOGRAH_UI_URL=https://dograh.capstone.innotel.us

# ── The links the console leaves by (see src/lib/console.ts) ──────────
# Every one is browsable-host, never a loopback port, for the same reason.
FREEPBX_ADMIN_URL=https://pbx.zeus.innotel.us
CAPSTONE_DASHBOARD_URL=https://dashboard.capstone.innotel.us
WORKFLOW_STUDIO_URL=https://workflow.capstone.innotel.us


