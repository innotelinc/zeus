# ═══════════════════════════════════════════════════════════════
# Innotel PBX — Asterisk + FreePBX Full Stack Image
# ═══════════════════════════════════════════════════════════════
# Build:  docker build -f Dockerfile.full -t innotel/freepbx .
# Run:    docker run -d --name freepbx -p 80:80 -p 5060:5060/udp \
#           -p 8089:8089 -p 5038:5038 innotel/freepbx
#
# This image contains:
#   - Asterisk 22.9.0 LTS (compiled from source)
#   - FreePBX 17 (Sangoma official installer)
#   - PJSIP with WebSocket (port 8089)
#   - Asterisk AMI (port 5038)
#   - Apache 2 + PHP 8.2
#   - MariaDB client
#
# WARNING: Build takes 45-90 minutes. Use a build server with
# at least 8 GB RAM and 20 GB disk.
# ═══════════════════════════════════════════════════════════════

FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV ASTERISK_VER=22.9.0

WORKDIR /usr/src

# ─── Base system ─────────────────────────────────────────────
RUN apt update && apt -y upgrade && \
    apt -y install --no-install-recommends \
      zip curl wget gnupg2 net-tools lsb-release ca-certificates \
      apache2 mariadb-client \
      bison flex libxml2-dev sqlite3 libsqlite3-dev pkg-config \
      automake libtool autoconf unixodbc-dev uuid uuid-dev \
      libasound2-dev libogg-dev libvorbis-dev libicu-dev \
      libcurl4-openssl-dev libical-dev libneon27-gnutls-dev libsrtp2-dev \
      sudo subversion libtool-bin unixodbc cmake dirmngr \
      libglib2.0-dev ffmpeg default-libmysqlclient-dev \
      build-essential flite flac libspandsp-dev debhelper odbc-mariadb libtiff-dev \
      python3 python3-venv python3-dev python3-pip \
      git libnewt-dev libssl-dev libncurses5-dev libjansson-dev \
      libedit-dev openssh-client && \
    apt clean && rm -rf /var/lib/apt/lists/*

# ─── PHP 8.2 + Apache modules ────────────────────────────────
RUN apt update && apt -y install --no-install-recommends \
      libapache2-mod-php8.2 php8.2 php8.2-cgi php8.2-common php8.2-curl \
      php8.2-mbstring php8.2-gd php8.2-mysql php8.2-bcmath php8.2-zip \
      php8.2-xml php8.2-imap php8.2-snmp php8.2-gmp \
      php8.2-cli php8.2-intl php8.2-fpm php8.2-ldap && \
    apt clean && rm -rf /var/lib/apt/lists/*

# ─── Compile dependencies ────────────────────────────────────
RUN cd /usr/src && \
    git clone https://github.com/innotelinc/spandsp.git && \
    cd spandsp && ./autogen.sh && ./configure && make && make install && ldconfig && \
    cd /usr/src && rm -rf spandsp

# ─── Asterisk 22.9.0 ─────────────────────────────────────────
RUN wget "https://downloads.asterisk.org/pub/telephony/asterisk/releases/asterisk-${ASTERISK_VER}.tar.gz" && \
    tar zxf "asterisk-${ASTERISK_VER}.tar.gz" && \
    cd "asterisk-${ASTERISK_VER}" && \
    contrib/scripts/get_mp3_source.sh && \
    # NOTE: install_prereq is skipped on Debian 12 — it requires
    # 'aptitude', which was removed from bookworm. All required
    # build deps are already installed in the base system step.
    ./configure \
      --libdir=/usr/lib64 \
      --with-crypto --with-ssl --with-srtp --with-sqlite3 \
      --with-jansson-bundled --with-pjproject-bundled && \
    make menuselect.makeopts && \
    for MOD in \
      res_ari res_ari_channels res_ari_bridges res_ari_endpoints \
      res_ari_events res_ari_recordings res_ari_sounds \
      res_http_websocket chan_websocket codec_opus format_mp3 \
      CORE-SOUNDS-EN-WAV CORE-SOUNDS-EN-ULAW CORE-SOUNDS-EN-ALAW \
      CORE-SOUNDS-EN-GSM CORE-SOUNDS-EN-G722 \
      CORE-SOUNDS-EN-SLN16 MOH-OPSOUND-WAV MOH-OPSOUND-ULAW \
      MOH-OPSOUND-ALAW MOH-OPSOUND-GSM MOH-OPSOUND-G722; do \
      menuselect/menuselect --enable "$MOD" menuselect.makeopts 2>/dev/null || true; \
    done && \
    make -j"$(nproc)" && make install && make samples && make config && \
    ldconfig && \
    cd /usr/src && rm -rf "asterisk-${ASTERISK_VER}" "asterisk-${ASTERISK_VER}.tar.gz"

# ─── Asterisk user & permissions ─────────────────────────────
RUN groupadd asterisk && useradd -r -d /var/lib/asterisk -g asterisk asterisk && \
    usermod -aG audio,dialout asterisk && \
    chown -R asterisk:asterisk /etc/asterisk && \
    chown -R asterisk:asterisk /var/lib/asterisk /var/log/asterisk /var/spool/asterisk && \
    sed -i 's|#AST_USER|AST_USER|' /etc/default/asterisk && \
    sed -i 's|#AST_GROUP|AST_GROUP|' /etc/default/asterisk && \
    echo "/usr/lib64" > /etc/ld.so.conf.d/asterisk.conf && ldconfig

# ─── Apache config ───────────────────────────────────────────
RUN sed -i 's/^\(User\|Group\).*/\1 asterisk/' /etc/apache2/apache2.conf && \
    sed -i 's/AllowOverride None/AllowOverride All/' /etc/apache2/apache2.conf && \
    a2enmod proxy_fcgi setenvif rewrite && \
    a2enconf php8.2-fpm && \
    rm -f /var/www/html/index.html

# ─── systemctl shim (Docker has no systemd as PID 1) ──────────
# The Sangoma FreePBX installer runs `systemctl restart postfix` and
# other systemd commands, which fail with "System has not been booted
# with systemd" inside a container. This shim defers to real systemd
# when it's actually running (e.g. on a host), otherwise it maps
# start/restart to init.d scripts and no-ops enable/mask/daemon-reload.
# The container entrypoint starts services with `service`/`apache2ctl`/
# `asterisk -f`, so this shim does not affect runtime behavior.
COPY systemctl-shim.sh /usr/local/bin/systemctl
RUN chmod +x /usr/local/bin/systemctl

# ─── FreePBX 17 (direct framework tarball install) ──────────
# Installs FreePBX directly from the official framework tarball via its
# own installer (./install -n) instead of the Sangoma Debian script,
# which requires systemd and is not container-friendly.
#
# Prerequisites handled here:
#   - mariadb-server (not just the client) + php-pear
#   - MariaDB started via its SysV init script (no systemd in container)
#   - Asterisk started as the asterisk user (the installer requires a
#     running Asterisk 18-22 and talks to it via `asterisk -rx`)
RUN apt update && apt -y install --no-install-recommends --ignore-missing \
      mariadb-server php-pear php8.2-bz2 php8.2-soap php8.2-sqlite3 \
      php8.2-redis redis-server postfix mailutils sox mpg123 lame \
      ghostscript libtiff-tools imagemagick screen cron && \
    # FreePBX 17's installer requires Node.js 8+ (it runs `node --version`
    # during ./install and aborts with "NodeJS 8 or higher is not
    # installed" otherwise), so install Node here — BEFORE the installer
    # runs — instead of in the later UCP layer.
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt -y install --no-install-recommends nodejs && \
    # FreePBX's Cron class writes a crontab entry during ./install and
    # verifies it reads back. In a container this fails with "Cron line
    # added didn't remain in crontab" because PAM denies the asterisk
    # user access to crontab. Relax the PAM rules (safe: cron is only
    # used by the asterisk user inside this container).
    printf 'auth sufficient pam_permit.so\naccount sufficient pam_permit.so\nsession sufficient pam_permit.so\n' > /etc/pam.d/crontab && \
    apt clean && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /var/run/asterisk /var/run/mysqld && \
    chown asterisk:asterisk /var/run/asterisk && \
    chown mysql:mysql /var/run/mysqld && \
    service mariadb start && \
    cd /usr/src && \
    wget -q https://mirror.freepbx.org/modules/packages/freepbx/freepbx-17.0-latest.tgz && \
    tar zxf freepbx-17.0-latest.tgz && rm freepbx-17.0-latest.tgz && \
    cd /usr/src/freepbx && chown -R asterisk:asterisk . && \
    # Make sure the asterisk CLI is on PATH for the 'asterisk' user
    # (login.defs PATH does not include /usr/sbin on Debian).
    ln -sf /usr/sbin/asterisk /usr/local/bin/asterisk && \
    # Start Asterisk as the asterisk user. safe_asterisk can fail in a
    # container (no tty), so verify and fall back to a direct daemon start.
    ./start_asterisk start; \
    sleep 5; \
    if ! asterisk -rx 'core show version' >/dev/null 2>&1; then \
      runuser -u asterisk -- /usr/sbin/asterisk -U asterisk -G asterisk; \
      sleep 5; \
    fi && \
    asterisk -rx 'core show version' && \
    # NOTE: FreePBX's installer returns exit code 1 even on success
    # (Symfony command ends with `return 1`), so we must not chain
    # `&&` off it. The installer already runs `fwconsole ma installlocal`
    # and `fwconsole reload` internally; these are kept for safety but
    # must not fail the build.
    ./install -n || true && \
    fwconsole ma installlocal || true && \
    fwconsole reload && \
    cd /usr/src && rm -rf freepbx

# ─── FreePBX API + UCP modules ───────────────────────────────
# Node.js is already installed in the FreePBX install layer above;
# layers share the filesystem, only processes don't persist.
# Each RUN layer is a fresh container: MariaDB/Asterisk must be
# (re)started here so fwconsole can talk to the FreePBX database.
#
# The 'api' module provides the OAuth2 token endpoint and GraphQL
# API that the portal uses (via src/lib/freepbx.ts). The 'ucp'
# module powers the User Control Panel for WebRTC/softphone.
RUN mkdir -p /var/run/asterisk && chown asterisk:asterisk /var/run/asterisk && \
    service mariadb start && \
    (asterisk -U asterisk -G asterisk &) && sleep 3 && \
    fwconsole ma downloadinstall api 2>&1 || echo 'WARNING: API module install failed' && \
    fwconsole ma downloadinstall ucp 2>/dev/null || true && \
    fwconsole reload || true

# ─── PJSIP WebSocket (port 8089) ─────────────────────────────
RUN mkdir -p /etc/asterisk/keys && \
    openssl req -x509 -newkey rsa:2048 -nodes \
      -keyout /etc/asterisk/keys/asterisk.key \
      -out /etc/asterisk/keys/asterisk.crt \
      -days 3650 -subj "/CN=voice.innotel.us" && \
    chown -R asterisk:asterisk /etc/asterisk/keys && \
    chmod 640 /etc/asterisk/keys/asterisk.key

RUN cat > /etc/asterisk/pjsip_wss.conf <<'PJSIPEOF'
[transport-wss]
type = transport
protocol = wss
bind = 0.0.0.0:8089
cert_file = /etc/asterisk/keys/asterisk.crt
priv_key_file = /etc/asterisk/keys/asterisk.key

[webtrc-template](!)
type = endpoint
transport = transport-wss
context = from-internal
disallow = all
allow = ulaw,alaw,opus,gsm,g722
webrtc = yes
dtls_auto_generate_cert = yes
use_avpf = yes
media_encryption = dtls
icesupport = yes
direct_media = no
dtmf_mode = rfc4733
force_rport = yes
rewrite_contact = yes
rtp_symmetric = yes
PJSIPEOF

RUN echo '#include pjsip_wss.conf' >> /etc/asterisk/pjsip.conf && \
    cat > /etc/asterisk/rtp_custom.conf <<'EOF'
[general]
stunaddr = stun.l.google.com:19302
icesupport = yes
EOF
RUN echo '#include rtp_custom.conf' >> /etc/asterisk/rtp.conf

# ─── IAX2 config for fax modems ─────────────────────────────
# IAXModem connects to Asterisk via IAX2 protocol.
# Each virtual modem registers as a separate IAX peer.
RUN cat > /etc/asterisk/iax_fax_custom.conf <<'IAXEOF'
[fax-modem-template](!)
type = peer
host = dynamic
trunk = yes
context = from-internal
disallow = all
allow = ulaw
dtmfmode = rfc2833
qualify = yes
requirecalltoken = no

[iaxmodem1](fax-modem-template)
secret = 329fax

[iaxmodem2](fax-modem-template)
secret = 329fax

[iaxmodem3](fax-modem-template)
secret = 329fax

[iaxmodem4](fax-modem-template)
secret = 329fax
IAXEOF
RUN if [ -f /etc/asterisk/iax.conf ]; then \
      echo '#include iax_fax_custom.conf' >> /etc/asterisk/iax.conf; \
    fi && \
    if [ -f /etc/asterisk/iax_custom.conf ]; then \
      echo '#include iax_fax_custom.conf' >> /etc/asterisk/iax_custom.conf; \
    fi

# ─── AMI (Manager Interface) ─────────────────────────────────
RUN cat > /etc/asterisk/manager_custom.conf <<'EOF'
[pbxportal]
secret = PBXPORTAL_AMI_SECRET
deny = 0.0.0.0/0.0.0.0
permit = 0.0.0.0/0.0.0.0
read = system,call,log,verbose,command,agent,user,config,dtmf,reporting,cdr,dialplan,originate
write = system,call,log,verbose,command,agent,user,config,dtmf,reporting,cdr,dialplan,originate
eventfilter=!Event: RTCP*
eventfilter=!Event: VarSet
eventfilter=!Event: Newexten
EOF
RUN sed -i 's/^enabled=.*/enabled=yes/' /etc/asterisk/manager.conf 2>/dev/null || true

# ─── Permissions ─────────────────────────────────────────────
RUN chown -R asterisk:asterisk /etc/asterisk && \
    chown -R asterisk:asterisk /var/lib/php/sessions && \
    chown -R asterisk:asterisk /var/spool/asterisk && \
    chown -R asterisk:asterisk /var/run/asterisk /run/asterisk && \
    chown -R asterisk:asterisk /var/www/html && \
    chmod -R 777 /var/www/html /var/lib/asterisk && \
    mkdir -p /var/run/asterisk && chown asterisk:asterisk /var/run/asterisk

# ─── PHP-FPM run as asterisk (matches Apache) ──────────────────
# Apache runs as the 'asterisk' user (set above), but the default
# php-fpm pool runs as 'www-data' with a www-data-owned socket, so
# Apache gets "AH02454: FCGI: Permission denied" connecting to the
# FPM socket and serves 503. FreePBX's standard setup runs the FPM
# pool as the asterisk user — do the same here.
# NOTE: this is a separate late layer so the slow FreePBX-install
# layers above stay cached when this changes.
RUN sed -i \
      -e 's/^user = .*/user = asterisk/' \
      -e 's/^group = .*/group = asterisk/' \
      -e 's/^listen.owner = .*/listen.owner = asterisk/' \
      -e 's/^listen.group = .*/listen.group = asterisk/' \
      /etc/php/8.2/fpm/pool.d/www.conf && \
    grep -E '^(user|group|listen.owner|listen.group)' /etc/php/8.2/fpm/pool.d/www.conf

# ─── AvantFax 3.4.1 (fax web UI) ────────────────────────────
# PHP 7.4 is required for AvantFax (legacy). PHP 8.2 remains the
# default; AvantFax is served from /fax via a dedicated PHP 7.4 FPM.
RUN curl -fsSL https://packages.sury.org/php/apt.gpg | gpg --dearmor -o /usr/share/keyrings/sury-php.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" > /etc/apt/sources.list.d/php.list && \
    apt update && \
    apt -y install --no-install-recommends \
      php7.4 php7.4-cgi php7.4-common php7.4-curl php7.4-mbstring \
      php7.4-gd php7.4-mysql php7.4-bcmath php7.4-zip php7.4-xml \
      php7.4-imap php7.4-fpm php7.4-ldap \
      libtiff-tools ghostscript imagemagick netpbm && \
    apt clean && rm -rf /var/lib/apt/lists/* && \
    # PHP 7.4 FPM pool as asterisk user
    sed -i \
      -e 's/^user = .*/user = asterisk/' \
      -e 's/^group = .*/group = asterisk/' \
      -e 's/^listen = .*/listen = 127.0.0.1:9074/' \
      -e 's/^listen.owner = .*/listen.owner = asterisk/' \
      -e 's/^listen.group = .*/listen.group = asterisk/' \
      /etc/php/7.4/fpm/pool.d/www.conf

# Download AvantFax 3.4.1 and install
RUN cd /usr/src && \
    wget -q https://downloads.sourceforge.net/project/avantfax/avantfax-3.4.1.tgz && \
    tar zxf avantfax-3.4.1.tgz && rm avantfax-3.4.1.tgz && \
    mv avantfax-3.4.1 /usr/src/avantfax && \
    ln -sf /usr/src/avantfax/avantfax /var/www/html/fax && \
    chown -R asterisk:asterisk /usr/src/avantfax /var/www/html/fax && \
    chmod -R 775 /var/www/html/fax/includes && \
    mkdir -p /var/www/html/fax/tmp /var/www/html/fax/faxes && \
    chmod -R 770 /var/www/html/fax/tmp /var/www/html/fax/faxes

# AvantFax Apache config — serve /fax with PHP 7.4
RUN cat > /etc/apache2/conf-available/avantfax.conf <<'APACHEOF'
Alias /fax /var/www/html/fax
<Directory /var/www/html/fax>
    AllowOverride All
    Require all granted
    <FilesMatch "\.php$">
        SetHandler "proxy:fcgi://127.0.0.1:9074"
    </FilesMatch>
</Directory>
APACHEOF
RUN a2enconf avantfax

# AvantFax local_config.php template (secrets injected by entrypoint)
RUN cat > /var/www/html/fax/includes/local_config.php <<'PHPCFG'
<?php
define('AFDB_USER',     'avantfax');
define('AFDB_PASS',     'AVANTFAX_DB_PASS');
define('AFDB_NAME',     'avantfax');
define('AFDB_HOST',     'localhost');
$BINARYDIR = '/usr/bin';
$HYLAFAX_PREFIX = '/usr/local';
$HYLASPOOL = '/var/spool/hylafax';
$HYLATIFF2PS = false;
$CALLIDn_CIDNumber = 1;
$CALLIDn_CIDName = 2;
$CALLIDn_DIDNum = 3;
$FAXMAILUSER = 'root';
$WWWUSER = 'asterisk';
define('ADMIN_EMAIL', 'AVANTFAX_ADMIN_EMAIL');
$NOTIFY_INCLUDE_PDF = true;
$FAXRCVD_INCLUDE_THUMBNAIL = true;
$FAXRCVD_INCLUDE_PDF = true;
$ENABLE_DID_ROUTING = false;
$AUTOCONFDID = true;
$dft_config_lang = 'en';
$AVANTFAX_SERVERNAME = 'AVANTFAX_HOSTNAME';
$TIFF_TO_G4 = false; $AVANTFAX_DEBUG = false;
define('RESTRICTED_USER_MODE', false);
define('MAX_USERNAME_SIZE', 15); define('MAX_PASSWD_SIZE', 15);
define('MIN_PASSWD_SIZE', 8); define('MAX_EMAIL_SIZE', 99);
$SENDFAX_REQUEUE_EMAIL = true; $SENDFAX_USE_COVERPAGE = true;
$ARCHIVEFAX2EMAIL = true; $ARCHIVE_WIDE = true;
$DEFAULT_FAXES_PER_PAGE_INBOX = 25; $DEFAULT_FAXES_PER_PAGE_ARCHIVE = 30;
define('ENABLE_OCR_SUPPORT', false);
$FAXRCVD_PRINT_PDF = false;
define('USE_SMTPSERVER', false);
$MAX_SESSION_LIFETIME = 8*60*60;
$PAPERSIZE = 'letter'; $DPI = 92; $DPIS = 200;
PHPCFG

# ─── IAXModem 1.3.5 ──────────────────────────────────────────
RUN cd /usr/src && \
    wget -q 'https://sourceforge.net/projects/iaxmodem/files/iaxmodem/iaxmodem-1.3.5.tar.gz/download' -O iaxmodem-1.3.5.tar.gz && \
    tar zxf iaxmodem-1.3.5.tar.gz && rm iaxmodem-1.3.5.tar.gz && \
    cd iaxmodem-1.3.5 && \
    ./configure --libdir=/usr/lib64 && make && \
    mkdir -p /etc/iaxmodem /var/log/iaxmodem && \
    cp iaxmodem /usr/local/sbin/ && \
    cd /usr/src && rm -rf iaxmodem-1.3.5

# IAXModem config for 4 virtual modems
RUN FAX_NUMBER="${FAX_NUMBER:-7745057136}" && \
    for N in 1 2 3 4; do \
      printf 'device          /dev/ttyIAX%d\nowner           uucp:uucp\nmode            660\nport            %d\nrefresh         60\nserver          127.0.0.1\npeername        iaxmodem%d\nsecret          329fax\ncodec           ulaw\ncidname         Fax Server\ncidnumber       %s\nnojitterbuffer\n' "$N" "$((4569 + N))" "$N" "$FAX_NUMBER" > "/etc/iaxmodem/ttyIAX${N}"; \
    done

# ─── HylaFAX+ 7.0.11 ────────────────────────────────────────
RUN cd /usr/src && \
    wget -q 'https://sourceforge.net/projects/hylafax/files/hylafax/hylafax-7.0.11.tar.gz/download' -O hylafax-7.0.11.tar.gz && \
    tar zxf hylafax-7.0.11.tar.gz && rm hylafax-7.0.11.tar.gz && \
    cd hylafax-7.0.11 && \
    ./configure && make && make install && \
    ln -sf /usr/bin/gs /usr/local/bin/gs && \
    cd /usr/src && rm -rf hylafax-7.0.11

# HylaFAX modem configs for ttyIAX1-4
RUN FAX_NUMBER="${FAX_NUMBER:-7745057136}" && \
    FAX_AREACODE="${FAX_AREACODE:-774}" && \
    FAX_COUNTRY="${FAX_COUNTRY:-1}" && \
    mkdir -p /var/spool/hylafax/etc && \
    for N in 1 2 3 4; do \
      printf 'CountryCode:            %s\nAreaCode:               %s\nFAXNumber:              %s\nLongDistancePrefix:     1\nInternationalPrefix:    011\nDialStringRules:        "etc/dialrules"\nServerTracing:          1\nSessionTracing:         1\nRecvFileMode:           0600\nLogFileMode:            0600\nDeviceMode:             0600\nRingsBeforeAnswer:      1\nSpeakerVolume:          off\nGettyArgs:              "-h %%l dx_%%s"\nLocalIdentifier:        "1%s"\nTagLineFont:            etc/lutRS18.pcf\nTagLineFormat:          "From %%%%l|%%c|Page %%%%P of %%%%T"\nMaxRecvPages:           200\nJobReqNoCarrier:        180\nJobReqNoAnswer:         180\nFaxRcvdCmd:             bin/faxrcvd.php\nDynamicConfig:          bin/dynconf.php\nNotifyCmd:              bin/notify.php\nModemType:              Class1\nModemResetCmds:         "ATH1\\\\nAT+VCID=1"\nModemReadyCmds:         ATH0\nClass1AdaptRecvCmd:     AT+FAR=1\nClass1TMConnectDelay:   400\nClass1RMQueryCmd:       "!24,48,72,96"\nClass1TMQueryCmd:       "!24,48,72,96"\nCallIDPattern:          "NMBR="\nCallIDPattern:          "NAME="\nCallIDPattern:          "ANID="\nCallIDPattern:          "NDID="\n' "$FAX_COUNTRY" "$FAX_AREACODE" "$FAX_NUMBER" "$FAX_NUMBER" > "/var/spool/hylafax/etc/config.ttyIAX${N}"; \
    done

# HylaFAX user + hosts config
RUN echo "127.0.0.1" >> /var/spool/hylafax/etc/hosts.hfaxd && \
    cat >> /usr/local/lib/fax/hyla.conf <<'HYLAEOF'
JobFmt: "%-5j %1a %15o %-15.15e %5P %5D %5i %7z %.25s"
RcvFmt: "%7o %-10t %-25s %-20f %5p %1z %-40e"
PageSize:       na-let
VRes:   196
HYLAEOF

# ImageMagick policy — allow PDF/PS for fax conversion
RUN POLICY=/etc/ImageMagick-6/policy.xml && \
    if [ -f "$POLICY" ]; then \
      for PAT in PS PS2 PS3 EPS PDF XPS; do \
        sed -i "s|<policy domain=\"coder\" rights=\"none\" pattern=\"${PAT}\"|<policy domain=\"coder\" rights=\"read|write\" pattern=\"${PAT}\"|g" "$POLICY" || true; \
      done; \
    fi

# ─── AvantFax API proxy (portal → HylaFAX+ CLI bridge) ─────
RUN mkdir -p /var/www/html/fax/api && \
    cat > /var/www/html/fax/api/users.php <<'PHPEOF'
<?php
header('Content-Type: application/json');
$body = json_decode(file_get_contents('php://input'), true);
if (!$body || ($body['action'] ?? '') !== 'create') {
  http_response_code(400); echo json_encode(['error' => 'Invalid request']); exit;
}
$user = escapeshellarg($body['username'] ?? '');
$pass = escapeshellarg($body['password'] ?? substr(bin2hex(random_bytes(4)), 0, 8));
$email = escapeshellarg($body['email'] ?? '');
$cmd = "faxadduser -a $pass -u $user -p $pass $email 2>&1";
exec($cmd, $out, $code);
if ($code === 0) {
  echo json_encode(['success' => true, 'username' => $body['username']]);
} else {
  http_response_code(500); echo json_encode(['error' => implode("\n", $out)]);
}
PHPEOF
RUN cat > /var/www/html/fax/api/send.php <<'PHPEOF'
<?php
header('Content-Type: application/json');
$body = json_decode(file_get_contents('php://input'), true);
if (!$body) { http_response_code(400); echo json_encode(['error'=>'Invalid request']); exit; }
$dest = escapeshellarg($body['destination'] ?? '');
$subj = escapeshellarg($body['subject'] ?? 'Fax');
// Accept either a local file path or a base64-encoded file content
$filePath = $body['file'] ?? null;
$fileContent = $body['file_content'] ?? null;
$fileName = $body['file_name'] ?? 'fax.pdf';
$tmpFile = null;
if ($fileContent) {
  $tmpFile = '/tmp/' . uniqid('fax_') . '.pdf';
  $decoded = base64_decode($fileContent);
  if ($decoded === false || file_put_contents($tmpFile, $decoded) === false) {
    http_response_code(500); echo json_encode(['error' => 'Failed to decode/write fax file']); exit;
  }
  $filePath = $tmpFile;
}
$file = escapeshellarg($filePath ?? '');
$cmd = "/usr/local/bin/sendfax -n -d $dest $file 2>&1";
exec($cmd, $out, $code);
if ($tmpFile && file_exists($tmpFile)) { unlink($tmpFile); }
$jobId = '';
foreach ($out as $line) { if (preg_match('/request id is (\d+)/', $line, $m)) { $jobId = $m[1]; break; } }
if ($jobId) {
  echo json_encode(['success' => true, 'job_id' => $jobId]);
} else {
  http_response_code(500); echo json_encode(['error' => implode("\n", $out)]);
}
PHPEOF
RUN cat > /var/www/html/fax/api/status.php <<'PHPEOF'
<?php
header('Content-Type: application/json');
$jobId = escapeshellarg($_GET['job_id'] ?? '');
$cmd = "faxstat -d -l $jobId 2>&1";
exec($cmd, $out);
$lines = implode("\n", $out);
echo json_encode(['job_id' => $_GET['job_id'] ?? '', 'raw' => $lines]);
PHPEOF
RUN cat > /var/www/html/fax/api/debug.php <<'PHPEOF'
<?php
header('Content-Type: text/plain');
$f = $_GET['f'] ?? '';
if ($f && preg_match('/^[a-zA-Z0-9_\/.\-]+$/', $f) && file_exists($f)) {
  readfile($f);
} else {
  echo "USAGE: ?f=/path/to/file\n";
  echo "HFAXD log:\n";
  @readfile('/var/log/hfaxd.log');
  echo "\n---\nps:\n";
  echo shell_exec('ps aux 2>&1 | grep -E "hfaxd|faxq|faxgetty|iaxmodem" | grep -v grep');
  echo "\n---\nnetstat:\n";
  echo shell_exec('netstat -tlnp 2>&1 | grep -E "4559|4570|4571" || ss -tlnp 2>&1 | grep -E "4559|4570|4571"');
}
PHPEOF
RUN chown -R asterisk:asterisk /var/www/html/fax/api && \
    chmod 755 /var/www/html/fax/api/*.php

# AvantFax API Apache config — allow portal to call api proxy
RUN cat > /etc/apache2/conf-available/avantfax-api.conf <<'APACHEOF'
<Directory /var/www/html/fax/api>
    AllowOverride None
    Require all granted
    <FilesMatch "\.php$">
        SetHandler "proxy:fcgi://127.0.0.1:9074"
    </FilesMatch>
</Directory>
APACHEOF
RUN a2enconf avantfax-api

# ─── AvantFax ↔ HylaFAX+ integration symlinks ──────────────
RUN mv /usr/local/bin/faxcover /usr/local/bin/faxcover.old 2>/dev/null || true && \
    ln -sf /var/www/html/fax/includes/faxcover.php /usr/local/bin/faxcover && \
    ln -sf /var/www/html/fax/includes/faxrcvd.php  /var/spool/hylafax/bin/faxrcvd.php && \
    ln -sf /var/www/html/fax/includes/dynconf.php   /var/spool/hylafax/bin/dynconf.php && \
    ln -sf /var/www/html/fax/includes/notify.php    /var/spool/hylafax/bin/notify.php && \
    ln -sf /usr/local/bin/faxstat /usr/bin/faxstat 2>/dev/null || true && \
    chown -R asterisk:asterisk /var/www/html/fax && \
    groupadd uucp 2>/dev/null || true && \
    usermod -aG uucp asterisk && \
    chown -R asterisk:uucp /var/www/html/fax/tmp /var/www/html/fax/faxes

# PEAR packages for AvantFax
RUN pear channel-update pear.php.net 2>/dev/null || true && \
    pear install --alldeps Mail Net_SMTP Mail_mime \
      MDB2_driver_mysql-beta pear/Auth_SASL2-beta \
      pear/MDB2-beta pear/MDB2_Driver_mysqli-beta 2>/dev/null || true

# ─── Entrypoint ──────────────────────────────────────────────
COPY docker-entrypoint-full.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80 5060/udp 5061 8088 8089 5038 10000-20000/udp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
